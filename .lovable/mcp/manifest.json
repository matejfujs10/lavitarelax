{
  "version": 1,
  "sdk_version": "3.1.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "la-vita-escape",
      "version": "0.1.0",
      "title": "La Vita Escape"
    },
    "tools": [
      {
        "name": "check_availability",
        "title": "Check availability",
        "description": "Check whether the La Vita house is free for a stay (check-in to check-out, YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "check_in": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Arrival date, YYYY-MM-DD."
            },
            "check_out": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Departure date, YYYY-MM-DD (exclusive)."
            }
          },
          "required": [
            "check_in",
            "check_out"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "calculate_price",
        "title": "Calculate stay price",
        "description": "Calculate the price in EUR for a stay at the La Vita house, including long-stay discounts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "check_in": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Arrival date, YYYY-MM-DD."
            },
            "check_out": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Departure date, YYYY-MM-DD."
            }
          },
          "required": [
            "check_in",
            "check_out"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
